# Dependencies and build output
node_modules/
dist/
.turbo/
coverage/

# Environment files — templates stay tracked
.env
.env.*
!.env.example
.env.test

# Logs
*.log

# OS / editor / agent-local state
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/

# Internal engineering documents (specs, plans) — kept on disk, never pushed
docs/

# UI review screenshots — local evidence, never part of the product
.shots-review/

# Lockfiles: pnpm-lock.yaml is authoritative
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Runtime file storage (ADR-09) — local disk, never committed
apps/api/uploads/

# Database dumps and backups — contain real account data
*.dump
*.sql.gz

# TypeScript incremental build state — churns on every build
*.tsbuildinfo
