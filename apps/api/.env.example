# ThesisTrack API — environment template (spec §18.4)
#
#   cp apps/api/.env.example apps/api/.env
#
# Every key below is read by src/config/env.ts. `.env` is gitignored — never commit it.
# Values marked [REQUIRED] have no default: the API refuses to boot without them.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development           # development | production | test
PORT=3001                      # web proxy and tests/tests/*.sh all assume 3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thesistrack   # [REQUIRED]
WEB_ORIGIN=http://localhost:5173   # allowed CORS origin; CORS is credentials:true

# ── Security ────────────────────────────────────────────────────────────────
# [REQUIRED] Use >= 32 random bytes in production. Generate one with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

# ── Token lifetimes (seconds) ───────────────────────────────────────────────
ACCESS_TOKEN_TTL=900           # 15 min   — access token lives in client memory
REFRESH_TOKEN_TTL=604800       # 7 days   — hashed row in `sessions`
ACTIVATION_TOKEN_TTL=259200    # 72 hours — account_tokens on provisioning
RESET_TOKEN_TTL=3600           # 1 hour   — password reset

# ── Cookies ─────────────────────────────────────────────────────────────────
# Refresh cookie is HTTP-only, SameSite=Lax, path-scoped to /api/v1/auth.
COOKIE_SECURE=false            # MUST be true when serving over HTTPS (spec §18.4)

# ── Known gap: JWT_REFRESH_SECRET (ADR-08, scheduled Phase 15.6) ────────────
# config/env.ts still declares JWT_REFRESH_SECRET, but nothing reads it —
# refresh tokens are opaque, not JWTs. It carries a devDefault, so it is
# deliberately absent here rather than advertised as dead configuration.
# Phase 15.6 deletes the declaration.

# ── Added in later phases (commented so they are not silently dropped) ──────
# UPLOAD_DIR=./uploads          # Phase 5.6  — spec §14.3 local-disk root
# UPLOAD_MAX_BYTES=20971520     # Phase 5.6  — 20 MB, spec §14.4
# TRUST_PROXY=true              # production — spec §18.4

# ── Optional: seed scripts (every one has a working default) ────────────────
# ADMIN_EMAIL=admin@thesistrack.local
# ADMIN_FIRST_NAME=Site
# ADMIN_LAST_NAME=Administrator
# ADMIN_PASSWORD=               # printed/required by pnpm seed:admin
# RBAC_FIXTURE_PASSWORD=        # default RbacFixtures123!
# RBAC_SUFFIX=
# ASSIGN_FIXTURE_PASSWORD=      # default RbacFixtures123!
# ASSIGN_SUFFIX=
# FIXTURES_OUT=                 # write JSON summary of seeded fixtures to a path
