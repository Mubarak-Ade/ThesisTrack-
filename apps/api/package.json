{
  "name": "@thesistrack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:rbac": "tsx src/scripts/seed-rbac-fixtures.ts",
    "seed:templates": "tsx src/scripts/seed-milestone-templates.ts",
    "authz:selftest": "tsx src/scripts/authz-selftest.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:drift": "bash scripts/schema-drift.sh",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@thesistrack/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.38.4",
    "envalid": "^8.2.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.4",
    "sanitize-html": "^2.17.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "supertest": "^7.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2"
  }
}
