# ThesisTrack deployment stack — interpolation template (spec §18.2–§18.4).
#
#   cp .env.example .env   # then fill the two REQUIRED values
#
# docker compose reads this file for ${VAR} substitution. It is gitignored —
# never commit it. API-side variables (token TTLs, upload caps, seeds) are NOT
# listed here: they default correctly in apps/api/src/config/env.ts, and the
# full annotated list lives in apps/api/.env.example.

# ── postgres service ────────────────────────────────────────────────────────
POSTGRES_USER=thesistrack
POSTGRES_PASSWORD=change-me-db-password        # REQUIRED
POSTGRES_DB=thesistrack

# ── api service ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string   # REQUIRED — openssl rand -base64 48
WEB_ORIGIN=http://localhost:8080               # canonical origin of the web service
COOKIE_SECURE=false                            # true behind HTTPS (caddy profile)
TRUST_PROXY=false                              # true behind the caddy proxy

# ── caddy profile (optional TLS edge, §18.5) ────────────────────────────────
DOMAIN=localhost                               # real domain for ACME certs

# ── email delivery (optional — see docs/deployment.md §2) ───────────────────
# All commented = outgoing mail disabled at runtime (safe no-op). To enable,
# uncomment and fill — compose passes them straight to the api service.
# Brevo key wins over SMTP when both are set.
# BREVO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ThesisTrack <no-reply@example.org>
